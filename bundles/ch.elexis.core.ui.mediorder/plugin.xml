<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         id="ch.elexis.core.ui.mediorder.fragment"
         point="org.eclipse.e4.workbench.model">
      <fragment
            apply="always"
            uri="fragment.e4xmi">
      </fragment>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            category="ch.elexis.preferences.LagerverwaltungPrefs"
            class="ch.elexis.core.ui.mediorder.internal.preferences.MediorderPreferencePage"
            id="ch.elexis.core.ui.mediorder.preferences"
            name="%mediorder_preference_page">
      </page>
   </extension>
   <extension
         point="ch.elexis.core.ui.KonsExtension">
      <Link
            KonsExtension="ch.elexis.core.ui.mediorder.internal.MediorderKonsExtension"
            name="MediorderHistoryLink">
      </Link>
   </extension>

</plugin>
